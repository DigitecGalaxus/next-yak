{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["config.ts", "loaders/**/*", "cross-file-resolver/**/*", "isolated-source-eval/**/*"],
  "exclude": ["isolated-source-eval/__tests__/fixtures/**"]
}
