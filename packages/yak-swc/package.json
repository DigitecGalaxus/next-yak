{
  "name": "@yak/swc",
  "version": "10.0.0",
  "description": "The Rust SWC plugin of yak that compiles styled components to plain CSS at build time, for @yak/react and @yak/solid.",
  "keywords": [
    "css-in-js",
    "rust",
    "styled-components",
    "swc",
    "swc-plugin",
    "wasm",
    "yak",
    "zero-runtime"
  ],
  "homepage": "https://yak.js.org/",
  "bugs": {
    "url": "https://github.com/galaxuslabs/yak/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jan Nicklas"
  },
  "maintainers": [
    {
      "name": "Luca Schneider"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxuslabs/yak.git",
    "directory": "packages/yak-swc"
  },
  "files": [],
  "main": "target/wasm32-wasip1/release/yak_swc.wasm",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:yak",
    "build:yak": "RUSTFLAGS=\"--cfg swc_ast_unknown -Clink-arg=--allow-undefined\" cargo build -p yak_swc --release --target=wasm32-wasip1",
    "prepublishOnly": "node ../../scripts/check-pnpm.js && npm run build",
    "format": "cargo fmt --all",
    "test": "cargo test -- --include-ignored",
    "test:wasm-fixtures": "node scripts/test-wasm-fixtures.mts",
    "test:snapshots": "cd yak_swc && UPDATE=1 cargo test -- --include-ignored"
  },
  "dependencies": {
    "@swc/counter": "catalog:core"
  },
  "devDependencies": {
    "@swc/core": "catalog:core"
  },
  "preferUnplugged": true
}
