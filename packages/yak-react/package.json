{
  "name": "@yak/react",
  "version": "10.0.0-rc.0",
  "description": "@yak/react is a CSS-in-JS library for React: styled-components syntax with CSS extracted at build time. Works with Next.js, Vite and Rsbuild.",
  "keywords": [
    "css-in-js",
    "next.js",
    "react",
    "styled-components",
    "typescript"
  ],
  "homepage": "https://yak.js.org/",
  "bugs": {
    "url": "https://github.com/DigitecGalaxus/next-yak/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jan Nicklas"
  },
  "maintainers": [
    {
      "name": "Luca Schneider"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DigitecGalaxus/next-yak.git"
  },
  "files": [
    "dist",
    "loaders",
    "runtime",
    "withYak",
    "rsbuild",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./static": {
      "types": "./dist/static/index.d.ts",
      "default": "./dist/static/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./withYak": {
      "types": "./dist/withYak/index.d.ts",
      "default": "./dist/withYak/index.js"
    },
    "./context/baseContext": {
      "types": "./dist/context/baseContext.d.ts",
      "default": "./dist/context/baseContext.js"
    },
    "./context": {
      "react-server": {
        "types": "./dist/context/index.server.d.ts",
        "default": "./dist/context/index.server.js"
      },
      "default": {
        "types": "./dist/context/index.d.ts",
        "default": "./dist/context/index.js"
      }
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./loaders/webpack-loader": "./dist/loaders/webpack-loader.js",
    "./vite": {
      "types": "./dist/loaders/vite-plugin.d.ts",
      "default": "./dist/loaders/vite-plugin.js"
    },
    "./cross-file-resolver": {
      "types": "./dist/cross-file-resolver/index.d.ts",
      "default": "./dist/cross-file-resolver/index.js"
    },
    "./isolated-source-eval": {
      "types": "./dist/isolated-source-eval/index.d.ts",
      "default": "./dist/isolated-source-eval/index.js"
    },
    "./rsbuild": {
      "types": "./dist/rsbuild/index.d.ts",
      "default": "./dist/rsbuild/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-pnpm.js && npm run build && npm run test && npm run test:types:code && npm run test:types:test",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:snapshots": "vitest run -u",
    "test:types:code": "tsc -p tsconfig.json",
    "test:types:test": "tsc -p ./runtime/__tests__/tsconfig.json",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@babel/parser": "catalog:core",
    "@swc/core": "catalog:core",
    "@yak/swc": "10.0.0-rc.0"
  },
  "devDependencies": {
    "@rsbuild/core": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@types/jest": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@types/webpack": "catalog:dev",
    "jsdom": "catalog:dev",
    "next": "catalog:dev",
    "react": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "yak-internals": "workspace:*"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=2.0.0",
    "@types/react": ">=19",
    "next": ">=16.1.0",
    "react": ">=19.0.0",
    "vite": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
