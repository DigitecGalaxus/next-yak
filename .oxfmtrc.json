{
  // oxfmt reflows the children of an MDX JSX element as inline text, which folds a
  // fenced code block inside one onto a single line and breaks the docs build. It hits
  // every <Tab>```bash ...``` </Tab> block, so .mdx is off limits. .md has no JSX and
  // stays formatted.
  "ignorePatterns": [
    "**/*.mdx",
    "**/dist/",
    "**/.next/",
    "**/.swc/",
    "**/.tanstack/",
    "**/.vercel/",
    "**/out/",
    "**/target/",
    "benchmarks/bench/dist/",
    "benchmarks/bench/generated/",
    "cross-file-tests/__tests__/.tmp/",
    "packages/yak-swc/yak_swc/tests/fixture/",
    "packages/yak-internals/isolated-source-eval/__tests__/fixtures/syntax-error.ts",
    "examples/next-js/next-env.d.ts",
    "docs/.source/",
    "docs/playground-wasm/out/",
    "docs/public/types/",
    "packages/eslint-plugin-yak/README.md",
    "packages/eslint-plugin-yak/docs/"
  ]
}
